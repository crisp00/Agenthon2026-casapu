{
  "name": "company-brain",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "demo:load": "sh tools/demo-reset.sh",
    "demo:reset": "sh tools/demo-reset.sh",
    "db:reset": "rm -f data/brain.db data/brain.db-wal data/brain.db-shm data/principals.json",
    "test:cov": "vitest run --coverage --coverage.include=src/lib/** --coverage.include=src/app/api/** --coverage.reporter=text",
    "world:make": "tsx tools/worldgen/cli.ts make",
    "world:gen": "tsx tools/worldgen/cli.ts gen",
    "world:lint": "tsx tools/worldgen/cli.ts lint",
    "world:check": "tsx tools/worldgen/cli.ts check",
    "world:play": "tsx tools/worldgen/cli.ts play",
    "inbox:example": "mkdir -p data/inbox data/news data/docs && cp examples/inbox/*.md data/inbox/ && cp examples/news/*.md data/news/ && cp examples/docs/*.md data/docs/",
    "eval:extract": "vitest run --config vitest.eval.config.mts",
    "world:principals": "tsx tools/worldgen/cli.ts principals"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
